{
    "cSpell.words": [
        "Allman",
        "chrono",
        "cout",
        "gcode",
        "hooksPath",
        "oneline",
        "pdk",
        "protobuf",
        "qbus",
        "vtk"
    ],
    // ── CMake Tools ──────────────────────────────────────────
    "cmake.useCMakePresets": "always",
    "cmake.configureOnOpen": true,
    "cmake.buildBeforeRun": true,
    "cmake.statusbar.visibility": "visible",
    "cmake.statusbar.advanced": {
        "status": { "visibility": "visible" },
        "debug": { "visibility": "visible" },
        "launch": { "visibility": "visible" },
        "launchTarget": { "visibility": "visible" },
        "kit": { "visibility": "visible" },
        "buildTarget": { "visibility": "visible" },
        "variant": { "visibility": "visible" },
        "ctest": { "visibility": "hidden" }
    },
    "cmake.debugConfig": {
        "environment": [
            {
                "name": "LD_LIBRARY_PATH",
                "value": "${workspaceFolder}/build/output/lib/Debug:${env:LD_LIBRARY_PATH}"
            },
            {
                "name": "QBUS_PLUGIN_PATH",
                "value": "${workspaceFolder}/build/output/plugin/Debug"
            }
        ]
    },
